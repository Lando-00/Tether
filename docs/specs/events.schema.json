          "description": "Queue depth after this enqueue",
          "minimum": 1,
          "title": "Queue Depth",
          "type": "integer"
        },
        "seq": {
          "description": "Per-turn monotonically-increasing sequence number",
          "minimum": 0,
          "title": "Seq",
          "type": "integer"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "ts": {
          "description": "Server-side emission timestamp (UTC)",
          "format": "date-time",
          "title": "Ts",
          "type": "string"
        },
        "turn_id": {
          "title": "Turn Id",
          "type": "string"
        },
        "type": {
          "const": "notebook_query_added",
          "default": "notebook_query_added",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "turn_id",
        "seq",
        "ts",
        "query",
        "queue_depth"
      ],
      "title": "NotebookQueryAdded",
      "type": "object"
    },
