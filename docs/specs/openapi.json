{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginCompleteBody": {
        "description": "Request body for ``POST /{id}/login/complete``.\n\n``payload`` is connector-specific (QR-scan confirmation, OAuth\nauthorization code, password, MFA code) per connector spec §3.5;\nwe intentionally accept an opaque dict here so the schema stays\nadditive when new connectors land.",
        "properties": {
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          }
        },
        "title": "LoginCompleteBody",
        "type": "object"
      },
      "MarkSeenBody": {
        "description": "Request body for ``POST /{id}/inbox/mark-seen`` (Phase 6.5).",
        "properties": {
          "event_ids": {
            "description": "Event ids to mark seen. Idempotent.",
            "items": {
              "type": "string"
            },
            "title": "Event Ids",
            "type": "array"
          }
        },
        "title": "MarkSeenBody",
        "type": "object"
      },
      "Message": {
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
