      "StreamRequest": {
        "properties": {
          "mode": {
            "default": "chat",
            "description": "Orchestrator mode. 'chat' uses ChattyAgentOrchestrator; 'research' uses NotebookOrchestrator (currently 501 Not Implemented). Honored on both Accept: text/event-stream (SSE) and application/x-ndjson (NDJSON back-compat) responses.",
            "enum": [
              "chat",
              "research"
            ],
            "title": "Mode",
            "type": "string"
          },
          "model_name": {
            "description": "The name of the model to use for this generation.",
            "pattern": "^[A-Za-z0-9._-]{1,128}$",
            "title": "Model Name",
            "type": "string"
          },
          "prompt": {
            "description": "The user's prompt.",
            "maxLength": 32768,
            "minLength": 1,
            "title": "Prompt",
            "type": "string"
          },
