  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/chat/stream": {
      "post": {
        "description": "Stream chat events. Content negotiation via Accept header:\n\n    text/event-stream                       -> SSE-framed v2 events (typed WireEvent)\n    application/x-ndjson; version=0         -> NDJSON v0 dict events (LEGACY OPT-IN; deprecated)\n    application/x-ndjson; version=1.0       -> NDJSON v2 events (explicit; same as default)\n    application/x-ndjson                    -> NDJSON v2 events (NEW DEFAULT)\n    (absent)                                -> NDJSON v2 events (NEW DEFAULT)\n\nResponse carries X-Tether-Protocol-Version: 1.0 on every path.\nv0 legacy responses additionally carry Warning: 299 per RFC 9110 §5.6.7.\n\nMode dispatch: body.mode selects the Orchestrator via the registry\n(settings.orchestrator.registry). Unimplemented modes (is_implemented=False)\nreturn 501 before any streaming begins. Unknown modes rejected by\nPydantic Literal with 422. Briefing §2 Seam B item 4; synthesis §3.5.\n\nDefault flipped to v2 NDJSON in p5-cutover-c-flip-default.\nSynthesis §11.3 R18; §4 Phase 5 step 56.",
        "operationId": "stream_api_v1_chat_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StreamRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Stream",
        "tags": [
          "chat"
        ]
      }
    },
    "/api/v1/connectors": {
      "get": {
        "description": "List every registered connector and its current health/auth.\n\nPer connector spec §3.8 row 1. ``health()`` and ``auth_status()``\nare contractually cheap (no network); we still defensively catch\nso one bad connector doesn't 500 the whole listing.",
        "operationId": "list_connectors_api_v1_connectors_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response List Connectors Api V1 Connectors Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Connectors",
        "tags": [
          "connectors"
        ]
      }
    },
    "/api/v1/connectors/{connector_id}/inbox": {
      "get": {
        "description": "Return inbox events for ``connector_id``.\n\nPhase 6.5 step 66g (synthesis §4): replaces the prior 501 stub\nwith the actual :class:`tether.context.inbox_store.SqliteInbox`\nquery path. The 404 pre-check via :func:`_resolve` keeps the\nbehaviour consistent with the other connector routes — unknown\nids surface clearly even before the inbox is consulted.\n\nPer connector spec §3.4 + ADR-0009.",
        "operationId": "get_inbox_api_v1_connectors__connector_id__inbox_get",
        "parameters": [
          {
            "in": "path",
            "name": "connector_id",
            "required": true,
            "schema": {
              "title": "Connector Id",
              "type": "string"
            }
          },
          {
            "description": "When true, return only events with inbox_seen=0 ordered by received_at ASC (oldest unread first); when false (default), return all events newest-first.",
            "in": "query",
            "name": "unread",
            "required": false,
            "schema": {
              "default": false,
              "description": "When true, return only events with inbox_seen=0 ordered by received_at ASC (oldest unread first); when false (default), return all events newest-first.",
              "title": "Unread",
              "type": "boolean"
            }
          },
          {
            "description": "Max events to return (1-500).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "description": "Max events to return (1-500).",
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response Get Inbox Api V1 Connectors  Connector Id  Inbox Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Inbox",
        "tags": [
          "connectors"
        ]
      }
    },
    "/api/v1/connectors/{connector_id}/inbox/mark-seen": {
      "post": {
        "description": "Mark inbox events as seen by the orchestrator.\n\nPhase 6.5 step 66g: idempotent flip of ``inbox_seen=0 -> 1`` for\nthe listed event ids. Returns ``{\"affected\": N}`` where ``N`` is\nthe number of rows actually updated (events already at\n``inbox_seen=1`` do not contribute). Empty ``event_ids`` is a\nno-op returning ``{\"affected\": 0}``.",
        "operationId": "mark_inbox_seen_api_v1_connectors__connector_id__inbox_mark_seen_post",
        "parameters": [
          {
            "in": "path",
            "name": "connector_id",
            "required": true,
            "schema": {
              "title": "Connector Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MarkSeenBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Mark Inbox Seen Api V1 Connectors  Connector Id  Inbox Mark Seen Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Mark Inbox Seen",
        "tags": [
          "connectors"
        ]
      }
    },
    "/api/v1/connectors/{connector_id}/login/begin": {
      "post": {
        "description": "Initiate the login flow for ``connector_id``.\n\nReturns a serialized :class:`LoginPrompt` (QR-code data URL, OAuth\nURL, password instructions, etc.) per connector spec §3.5.\n\nPhase 4.5 follow-up (rubber-duck consensus, 1m CONCERN): if the\nconnector emits an ``oauth_state`` token in ``LoginPrompt.extra``,\npersist it in the registry's TTL cache so a subsequent\n``/oauth/callback?state=...`` can validate the round-trip\n(CSRF guard). Without this hop, Phase 2b Gmail's OAuth flow could\nnever succeed end-to-end — ``oauth_callback`` would always 400 on\nmissing state. Connectors that don't use OAuth (e.g. EchoConnector,\nWhatsApp's QR flow) simply omit ``oauth_state`` and this branch\nis a no-op.",
        "operationId": "login_begin_api_v1_connectors__connector_id__login_begin_post",
        "parameters": [
          {
            "in": "path",
            "name": "connector_id",
            "required": true,
            "schema": {
              "title": "Connector Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Login Begin Api V1 Connectors  Connector Id  Login Begin Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login Begin",
        "tags": [
          "connectors"
        ]
      }
    },
    "/api/v1/connectors/{connector_id}/login/complete": {
      "post": {
        "description": "Submit user-provided login data; on READY, start the connector.\n\nPer connector spec §3.5 + §3.3 step 7 (registry.start_connector(id)\nruns after a successful complete_login so the user gets a working\nconnector without restarting the process).",
        "operationId": "login_complete_api_v1_connectors__connector_id__login_complete_post",
        "parameters": [
          {
            "in": "path",
            "name": "connector_id",
            "required": true,
            "schema": {
              "title": "Connector Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginCompleteBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Login Complete Api V1 Connectors  Connector Id  Login Complete Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login Complete",
        "tags": [
          "connectors"
        ]
      }
    },
    "/api/v1/connectors/{connector_id}/logout": {
      "post": {
        "description": "Delete persisted creds + stop the connector + transition to LOGGED_OUT.\n\nPer connector spec §3.8: ``logout()`` is responsible for credential\ndeletion; the registry is responsible for stopping background tasks\n/ connections owned by the connector. Both must run.\n\nPhase 4.5 follow-up (rubber-duck consensus, gpt-5.5 BLOCKING #2):\npreviously this route only called ``conn.logout()`` and explicitly\nskipped ``registry.stop_connector()``. That left\n``inbound_stream`` consumers, scheduled tasks, and any open\nconnections alive after credentials were deleted — a use-after-\nlogout hazard that future Gmail/WhatsApp connectors would hit.\n\nOrder: credentials first (so a slow stop can't keep using them),\nthen ``stop_connector`` with the registry's 2 s cooperative budget\n(spec §3.3 step 6). ``stop_connector`` is idempotent and swallows\nits own exceptions so a flaky stop never bubbles up here.",
        "operationId": "logout_api_v1_connectors__connector_id__logout_post",
        "parameters": [
          {
            "in": "path",
            "name": "connector_id",
            "required": true,
            "schema": {
              "title": "Connector Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Logout Api V1 Connectors  Connector Id  Logout Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Logout",
        "tags": [
          "connectors"
        ]
      }
    },
    "/api/v1/connectors/{connector_id}/oauth/callback": {
      "get": {
        "description": "OAuth redirect target (Gmail-style flows).\n\nPer connector spec §3.8 row 3: verifies ``state`` against the\nregistry's TTL cache (populated by ``begin_login`` on the connector\nside), then forwards ``{state, code, state_payload}`` to\n:meth:`Connector.complete_login`. Mirrors ``login/complete`` for\nthe start-on-READY behavior.\n\nReturns JSON for now; Phase 2a/2b sessions may swap this for a\nredirect to a friendly success page once the desktop UI exists.\nMissing/expired state → 400 (CSRF protection).",
        "operationId": "oauth_callback_api_v1_connectors__connector_id__oauth_callback_get",
        "parameters": [
          {
            "in": "path",
            "name": "connector_id",
            "required": true,
            "schema": {
              "title": "Connector Id",
              "type": "string"
            }
          },
          {
            "description": "OAuth state token (CSRF guard).",
            "in": "query",
            "name": "state",
            "required": true,
            "schema": {
              "description": "OAuth state token (CSRF guard).",
              "title": "State",
              "type": "string"
            }
          },
          {
            "description": "OAuth authorization code.",
            "in": "query",
            "name": "code",
            "required": true,
            "schema": {
              "description": "OAuth authorization code.",
              "title": "Code",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Oauth Callback Api V1 Connectors  Connector Id  Oauth Callback Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Oauth Callback",
        "tags": [
          "connectors"
        ]
      }
    },
